                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"author\": \"\",\n  \"price\": -10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "PUT - Uppdatera bok komplett",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Boken är uppdaterad', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.equal('Uppdaterad titel');",
                  "    pm.expect(jsonData.price).to.equal(399.0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Uppdaterad titel\",\n  \"author\": \"Ny författare\",\n  \"price\": 399.0,\n  \"stock\": 10,\n  \"genre\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "PATCH - Partiell uppdatering",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Endast priset är ändrat', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.price).to.equal(99.0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 99.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "DELETE - Ta bort bok",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
