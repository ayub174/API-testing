              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Svaret innehåller en token, roll och behörigheter', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.token).to.not.be.empty;",
                  "    pm.expect(jsonData.role).to.equal('ADMIN');",
                  "    pm.expect(jsonData.permissions).to.be.an('array');",
                  "});",
                  "",
                  "// Spara token automatiskt i collection-variabeln",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('token', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
