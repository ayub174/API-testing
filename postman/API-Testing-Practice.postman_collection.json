    {
      "name": "5. Behörigheter & roller",
      "description": "Visar skillnaden mellan ADMIN och HANDLÄGGARE samt admin-endpoints för att lägga till/ta bort behörigheter. Kör requesterna uppifrån och ned.",
      "item": [
        {
          "name": "POST - Login som handläggare",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Rollen är HANDLAGGARE och saknar BOOK_DELETE', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.role).to.equal('HANDLAGGARE');",
                  "    pm.expect(jsonData.permissions).to.not.include('BOOK_DELETE');",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('handlaggareToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"handlaggare\",\n  \"password\": \"handlaggare123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "DELETE - Bok som handläggare (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Felmeddelandet handlar om behörighet', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('behörighet');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{handlaggareToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "1"]
            }
          }
        },
        {
          "name": "GET - Admin-konton som handläggare (403)",
