{
  "info": {
    "name": "API Testing Practice",
    "description": "Övningssamling för API-testning. Innehåller exempel för alla HTTP-metoder, autentisering (JWT), roller/behörigheter, validering, statuskoder och Postman-tester.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Logga in automatiskt som admin om token saknas. Detta gör att t.ex.",
          "// bok-endpoints (som nu kräver behörigheten BOOK_READ) fungerar oavsett",
          "// i vilken ordning requesterna körs i Collection Runner.",
          "if (!pm.collectionVariables.get('token')) {",
          "    pm.sendRequest({",
          "        url: pm.collectionVariables.get('baseUrl') + '/api/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ username: 'admin', password: 'hemligt123' }) }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            pm.collectionVariables.set('token', res.json().token);",
          "        }",
          "    });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "handlaggareToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Books - CRUD",
      "description": "OBS: bok-endpoints kräver nu inloggning (behörigheten BOOK_READ för läsning, BOOK_CREATE/UPDATE/DELETE för ändringar). Collectionens pre-request loggar automatiskt in som admin.",
      "item": [
        {
          "name": "GET - Hämta alla böcker",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Svaret innehåller en lista med böcker', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.books).to.be.an('array');",
                  "    pm.expect(jsonData.count).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response-tid är under 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "// Spara första bokens id i en collection-variabel",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.books && jsonData.books.length > 0) {",
                  "    pm.collectionVariables.set('bookId', jsonData.books[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "GET - Filtrera böcker (query params)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Alla böcker matchar genre-filtret', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.books.forEach(function(book) {",
                  "        pm.expect(book.genre.toLowerCase()).to.equal('programming');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books?genre=Programming&sortBy=price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "genre", "value": "Programming" },
                { "key": "sortBy", "value": "price" }
              ]
            }
          }
        },
        {
          "name": "GET - Hämta bok med ID (path param)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Boken har alla förväntade fält', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('author');",
                  "    pm.expect(jsonData).to.have.property('price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "GET - Bok med ID som inte finns (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Felmeddelandet innehåller text om att boken inte hittas', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('hittades inte');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "9999"]
            }
          }
        },
        {
          "name": "POST - Skapa ny bok",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status är 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Svaret innehåller boken med ett id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.title).to.equal('Min nya bok');",
                  "});",
                  "",
                  "pm.test('Location-header pekar på den nya boken', function () {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include('/api/books/');",
                  "});",
                  "",
                  "// Spara nya bokens id för efterföljande tester",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('bookId', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Min nya bok\",\n  \"author\": \"Test Författare\",\n  \"price\": 199.0,\n  \"stock\": 5,\n  \"genre\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
